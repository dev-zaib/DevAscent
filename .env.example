# DevAscent Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# DATABASE & INFRASTRUCTURE
# =============================================================================
DATABASE_URL=postgresql+asyncpg://devascent:devascent@localhost:5432/devascent
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# OpenAI — used for embeddings (text-embedding-3-small) and evaluation
OPENAI_API_KEY=

# Anthropic — used for code review and challenge escalation (Claude Sonnet/Opus)
ANTHROPIC_API_KEY=

# OpenRouter — fallback provider, 200+ models
# OPENROUTER_API_KEY=

# =============================================================================
# AUTH (NextAuth.js)
# =============================================================================
# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# JWT secret for credential-based sessions
NEXTAUTH_SECRET=change-me-to-a-random-string
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# ASSESSMENT CONFIG
# =============================================================================
# Model routing (comma-separated — first available wins)
DEVASCENT_EVALUATION_MODEL=anthropic/claude-sonnet-4
DEVASCENT_ESCALATION_MODEL=anthropic/claude-opus-4
DEVASCENT_EMBEDDING_MODEL=text-embedding-3-small

# Sandbox security
DEVASCENT_SANDBOX_TIMEOUT=30
DEVASCENT_MAX_SUBMISSIONS_PER_HOUR=10
# DeepSeek (assessment grading) — https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
